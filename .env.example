# Copy to .env and replace placeholder values before production use.

# PostgreSQL / Docker Compose
POSTGRES_DB=taskdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-database-password

# Optional legacy aliases supported by docker-compose.yml
DB_NAME=taskdb
DB_USER=postgres
DB_PASSWORD=replace-with-a-database-password

# Service ports
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Backend auth seed user
TASK_MANAGER_AUTH_USERNAME=admin
TASK_MANAGER_AUTH_PASSWORD=replace-with-an-admin-password
TASK_MANAGER_AUTH_ROLE=ROLE_ADMIN

# CORS and frontend API target
TASK_MANAGER_CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080

# JWT
JWT_SECRET=replace-with-a-long-base64-encoded-secret
JWT_EXPIRATION_MS=86400000
